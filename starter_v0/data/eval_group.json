  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_news_today_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tin tức mới nhất về OpenAI hôm nay là gì?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "topic": "news",
              "timeframe": "day"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_web_news_today",
        "difficulty": "medium",
        "what_it_tests": "Tin tức thời sự 'hôm nay' → lookup với topic=news, timeframe=day; không nhầm sang social_search."
      }
    },
    {
      "id": "G02_search_top_arg",
      "phase": "B",
      "suite": "group",
      "query": "Tìm những bài đăng được quan tâm nhất về DeepSeek trên mạng xã hội",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "social_search",
            "args": {
              "search_type": "Top"
            }
          }
        ]
      },
      "metadata": {
        "skill": "arg_search_type_top",
        "difficulty": "medium",
        "what_it_tests": "'Được quan tâm nhất / hot nhất' → search_type=Top (không phải Latest mặc định)."
      }
    },
    {
